DATABASE_URL=sqlite:///./ecopunto.db
# Add JWT_SECRET_KEY with a generated random value of at least 32 characters.
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
